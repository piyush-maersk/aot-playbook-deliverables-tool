# Copy to .env.local and adjust.
# dev   = local sign-in without Entra (backend must also run with AUTH_MODE=dev)
# entra = Microsoft Entra ID SSO via MSAL
VITE_AUTH_MODE=dev
VITE_API_BASE_URL=/api

# Entra ID (only for VITE_AUTH_MODE=entra)
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=
# Scope exposed by the API app registration, e.g. api://<api-client-id>/access_as_user
VITE_API_SCOPE=
VITE_REDIRECT_URI=http://localhost:5179
