# Copy to .env and adjust. All settings are environment variables (see app/config.py).

# Local dev uses SQLite; production uses PostgreSQL (psycopg 3 async driver).
DATABASE_URL=sqlite+aiosqlite:///./aot_dev.db
# DATABASE_URL=postgresql+psycopg://aot:<password>@<host>:5432/aot_deliverables
DB_POOL_MAX=10
RUN_MIGRATIONS=true

# dev = no token validation (local only!); entra = validate Microsoft Entra ID access tokens
AUTH_MODE=dev
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_AUDIENCE=
ADMIN_EMAILS=

CORS_ORIGINS=http://localhost:5179
PATH_PREFIX=
KEEP_VERSIONS=50
VERSION_MERGE_MINUTES=10
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25
